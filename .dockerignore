# The vault image build context is the whole checkout, which holds
# gigabytes of build output: ship only the plugin sources instead.
*
!seine-pgp/
!seine-pgp/go.mod
!seine-pgp/go.sum
!seine-pgp/*.go
!seine-pkcs7/
!seine-pkcs7/go.mod
!seine-pkcs7/*.go
!seine-sbsign/
!seine-sbsign/go.mod
!seine-sbsign/go.sum
!seine-sbsign/*.go
!seine-kmod/
!seine-kmod/go.mod
!seine-kmod/go.sum
!seine-kmod/*.go
!vault-image/Dockerfile
