# The vault image build context is the whole checkout, which holds
# gigabytes of build output: ship only the plugin sources instead.
*
!vault/
!vault/openbao/
!vault/openbao/image/Dockerfile
!vault/openbao/plugins/
!vault/openbao/plugins/pgp/
!vault/openbao/plugins/pgp/go.mod
!vault/openbao/plugins/pgp/go.sum
!vault/openbao/plugins/pgp/*.go
!vault/openbao/plugins/pkcs7/
!vault/openbao/plugins/pkcs7/go.mod
!vault/openbao/plugins/pkcs7/*.go
!vault/openbao/plugins/sbsign/
!vault/openbao/plugins/sbsign/go.mod
!vault/openbao/plugins/sbsign/go.sum
!vault/openbao/plugins/sbsign/*.go
!vault/openbao/plugins/kmod/
!vault/openbao/plugins/kmod/go.mod
!vault/openbao/plugins/kmod/go.sum
!vault/openbao/plugins/kmod/*.go
