# Kernel configuration fragment for the Raspberry Pi 4 (BCM2711) and
# nothing else: every other multiplatform board arm64 supports turned
# off, plus this board's own drivers pushed from module to built-in, so
# it boots its own storage and network without waiting on module loading.
# Every symbol was checked against Debian's arm64 debian/config: an
# unrecognized one is silently accepted and does nothing.

# Other SoC families arm64's multiplatform kernel carries: Qualcomm,
# MediaTek, Rockchip, Allwinner, NXP/Freescale, Renesas, Marvell,
# HiSilicon, Amlogic, TI K3, Broadcom's server (Seattle/Vulcan/ThunderX)
# and Cavium/XGene builds, and the reference/eval boards (Versatile
# Express, ARM Juno). CONFIG_ARCH_BCM and CONFIG_ARCH_BCM2835 are left
# on: they are what selects this board's own drivers below.
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# Other GPU drivers, one per SoC family above. CONFIG_DRM_VC4 -- the
# Pi 4's own -- is left on.
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_LIMA is not set
# CONFIG_DRM_MEDIATEK is not set
# CONFIG_DRM_MSM is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_ROCKCHIP is not set
# CONFIG_DRM_TEGRA is not set

# Other wireless chips. CONFIG_BRCMFMAC and CONFIG_BRCMFMAC_SDIO -- the
# Pi 4's own, over its SDIO-attached BCM43455 -- are left on.
# CONFIG_ATH9K is not set
# CONFIG_ATH9K_HTC is not set
# CONFIG_ATH10K is not set
# CONFIG_ATH11K is not set
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# CONFIG_IWLWIFI is not set
# CONFIG_LIBERTAS is not set
# CONFIG_MT7601U is not set
# CONFIG_MT7615E is not set
# CONFIG_MT7663U is not set
# CONFIG_MWIFIEX is not set
# CONFIG_RSI_91X is not set
# CONFIG_RTL8180 is not set
# CONFIG_RTL8187 is not set
# CONFIG_RTL8188EE is not set
# CONFIG_RTL8192CE is not set
# CONFIG_RTL8192CU is not set
# CONFIG_RTL8192DE is not set
# CONFIG_RTL8192EE is not set
# CONFIG_RTL8192SE is not set
# CONFIG_RTL8723AE is not set
# CONFIG_RTL8723BE is not set
# CONFIG_RTL8723BS is not set
# CONFIG_RTL8821AE is not set
# CONFIG_RTL8XXXU is not set
# CONFIG_RTW88 is not set
# CONFIG_RTW89 is not set
# CONFIG_WLCORE is not set

# Built in rather than modules: this board's own storage and network,
# so a rootfs on SD card or eMMC and a wired link come up without
# waiting on module loading first. Debian ships both as modules, which
# works too through the initramfs; this only saves that step.
CONFIG_MMC_SDHCI_IPROC=y
CONFIG_BCMGENET=y

# The wireless stack itself, off in examples/configs/slim-common.fragment.
# Restated because this fragment comes after it in 'config', where the
# last fragment listed wins.
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=m
